# Pruuf Environment Variables Template
# Copy this file to .env.development or .env.production and update values
#
# IMPORTANT: For Expo apps, use EXPO_PUBLIC_ prefix for client-accessible variables
# Variables without EXPO_PUBLIC_ prefix are server-side only (Edge Functions)

# ===========================================
# CLIENT-SIDE VARIABLES (EXPO_PUBLIC_ prefix)
# These are bundled into the app - DO NOT put secrets here!
# ===========================================

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/[project-id]/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://ivnstzpolgjzfqduhlvw.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_secret_63q_gauE8DdA-cMRO877_Q_FztyIbyP

# API Base URL
EXPO_PUBLIC_API_BASE_URL=https://api.pruuf.me

# Expo/EAS Configuration
# Get project ID from: https://expo.dev/accounts/[username]/projects/[project]
EXPO_PUBLIC_EXPO_PROJECT_ID=bd21c5ca-f051-4310-8985-70f10ec8a2db


# Feature Flags
EXPO_PUBLIC_ENABLE_DEV_TOOLS=false

# ===========================================
# SERVER-SIDE VARIABLES (Backend/Edge Functions)
# Set via: supabase secrets set KEY=VALUE
# ===========================================

